{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug salvium-wallet-gui",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/release/bin/salvium-wallet-gui",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "QML Test",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/release/bin/salvium-wallet-gui",
      "args": ["--test-qml"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
